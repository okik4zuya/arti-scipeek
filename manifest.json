{
  "manifest_version": 3,
  "name": "ARTi SciPeek — Journal Metrics for Scopus, ScienceDirect & Scholar",
  "version": "1.0.0",
  "description": "Journal Quartile, SJR and H-index on Scopus, ScienceDirect, Google Scholar and publisher pages. Fully offline, no data collected.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "popup.html"
  },
  "permissions": ["offscreen", "activeTab"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/arti-logo-48.png"],
      "matches": [
        "*://*.scopus.com/*",
        "*://*.sciencedirect.com/*",
        "*://*.link.springer.com/*",
        "*://*.nature.com/*",
        "*://*.pubs.acs.org/*",
        "*://*.pubs.rsc.org/*",
        "*://*.rsc.org/*",
        "*://*.tandfonline.com/*",
        "*://*.onlinelibrary.wiley.com/*",
        "*://*.mdpi.com/*",
        "*://*.iopscience.iop.org/*",
        "*://*.ieeexplore.ieee.org/*",
        "*://*.journals.sagepub.com/*",
        "*://*.academic.oup.com/*",
        "*://*.frontiersin.org/*",
        "*://*.science.org/*",
        "*://*.pubs.aip.org/*",
        "*://*.journals.aps.org/*",
        "*://*.cambridge.org/*",
        "*://*.degruyter.com/*",
        "*://*.degruyterbrill.com/*",
        "*://*.journals.plos.org/*",
        "*://*.cell.com/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.scopus.com/*"],
      "js": ["content-common.js", "content-scopus.js", "content-floating.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.sciencedirect.com/*"],
      "js": ["content-common.js", "content-sciencedirect.js", "content-floating.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.link.springer.com/*",
        "*://*.nature.com/*",
        "*://*.pubs.acs.org/*",
        "*://*.pubs.rsc.org/*",
        "*://*.rsc.org/*",
        "*://*.tandfonline.com/*",
        "*://*.onlinelibrary.wiley.com/*",
        "*://*.mdpi.com/*",
        "*://*.iopscience.iop.org/*",
        "*://*.ieeexplore.ieee.org/*",
        "*://*.journals.sagepub.com/*",
        "*://*.academic.oup.com/*",
        "*://*.frontiersin.org/*",
        "*://*.science.org/*",
        "*://*.pubs.aip.org/*",
        "*://*.journals.aps.org/*",
        "*://*.cambridge.org/*",
        "*://*.degruyter.com/*",
        "*://*.degruyterbrill.com/*",
        "*://*.journals.plos.org/*",
        "*://*.cell.com/*"
      ],
      "js": ["content-common.js", "content-floating.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://scholar.google.com/scholar*",
        "*://scholar.google.co.id/scholar*",
        "*://scholar.google.co.uk/scholar*",
        "*://scholar.google.co.in/scholar*",
        "*://scholar.google.com.au/scholar*",
        "*://scholar.google.ca/scholar*",
        "*://scholar.google.de/scholar*",
        "*://scholar.google.fr/scholar*",
        "*://scholar.google.it/scholar*",
        "*://scholar.google.es/scholar*",
        "*://scholar.google.nl/scholar*",
        "*://scholar.google.co.jp/scholar*",
        "*://scholar.google.com.br/scholar*",
        "*://scholar.google.ru/scholar*",
        "*://scholar.google.co.kr/scholar*",
        "*://scholar.google.com.tw/scholar*",
        "*://scholar.google.com.hk/scholar*",
        "*://scholar.google.com.sg/scholar*",
        "*://scholar.google.com.my/scholar*",
        "*://scholar.google.co.nz/scholar*",
        "*://scholar.google.co.za/scholar*",
        "*://scholar.google.com.mx/scholar*",
        "*://scholar.google.com.tr/scholar*",
        "*://scholar.google.pl/scholar*",
        "*://scholar.google.se/scholar*",
        "*://scholar.google.no/scholar*",
        "*://scholar.google.dk/scholar*",
        "*://scholar.google.fi/scholar*",
        "*://scholar.google.be/scholar*",
        "*://scholar.google.ch/scholar*",
        "*://scholar.google.at/scholar*",
        "*://scholar.google.pt/scholar*",
        "*://scholar.google.gr/scholar*",
        "*://scholar.google.cz/scholar*",
        "*://scholar.google.hu/scholar*",
        "*://scholar.google.ro/scholar*",
        "*://scholar.google.ie/scholar*",
        "*://scholar.google.cl/scholar*",
        "*://scholar.google.com.ar/scholar*",
        "*://scholar.google.com.co/scholar*",
        "*://scholar.google.co.th/scholar*",
        "*://scholar.google.com.vn/scholar*",
        "*://scholar.google.com.ph/scholar*",
        "*://scholar.google.com.pk/scholar*",
        "*://scholar.google.ae/scholar*",
        "*://scholar.google.sa/scholar*",
        "*://scholar.google.co.il/scholar*"
      ],
      "js": ["content-common.js", "content-scholar-results.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://scholar.google.com/citations*",
        "*://scholar.google.co.id/citations*",
        "*://scholar.google.co.uk/citations*",
        "*://scholar.google.co.in/citations*",
        "*://scholar.google.com.au/citations*",
        "*://scholar.google.ca/citations*",
        "*://scholar.google.de/citations*",
        "*://scholar.google.fr/citations*",
        "*://scholar.google.it/citations*",
        "*://scholar.google.es/citations*",
        "*://scholar.google.nl/citations*",
        "*://scholar.google.co.jp/citations*",
        "*://scholar.google.com.br/citations*",
        "*://scholar.google.ru/citations*",
        "*://scholar.google.co.kr/citations*",
        "*://scholar.google.com.tw/citations*",
        "*://scholar.google.com.hk/citations*",
        "*://scholar.google.com.sg/citations*",
        "*://scholar.google.com.my/citations*",
        "*://scholar.google.co.nz/citations*",
        "*://scholar.google.co.za/citations*",
        "*://scholar.google.com.mx/citations*",
        "*://scholar.google.com.tr/citations*",
        "*://scholar.google.pl/citations*",
        "*://scholar.google.se/citations*",
        "*://scholar.google.no/citations*",
        "*://scholar.google.dk/citations*",
        "*://scholar.google.fi/citations*",
        "*://scholar.google.be/citations*",
        "*://scholar.google.ch/citations*",
        "*://scholar.google.at/citations*",
        "*://scholar.google.pt/citations*",
        "*://scholar.google.gr/citations*",
        "*://scholar.google.cz/citations*",
        "*://scholar.google.hu/citations*",
        "*://scholar.google.ro/citations*",
        "*://scholar.google.ie/citations*",
        "*://scholar.google.cl/citations*",
        "*://scholar.google.com.ar/citations*",
        "*://scholar.google.com.co/citations*",
        "*://scholar.google.co.th/citations*",
        "*://scholar.google.com.vn/citations*",
        "*://scholar.google.com.ph/citations*",
        "*://scholar.google.com.pk/citations*",
        "*://scholar.google.ae/citations*",
        "*://scholar.google.sa/citations*",
        "*://scholar.google.co.il/citations*"
      ],
      "js": ["content-common.js", "content-scholar-profile.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
